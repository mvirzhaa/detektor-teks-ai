# Salin menjadi .env lalu sesuaikan
POSTGRES_DB=detektor
POSTGRES_USER=detektor
POSTGRES_PASSWORD=ganti-dengan-password-kuat

# Port web di host.
# Lokal: 3000
# Server utility.uika-bogor.ac.id: 3002 (port 3000 dipakai OlahPDF, 3001 dipakai Presensi)
WEB_PORT=3000

# Subpath URL saat diakses via reverse proxy Nginx.
# Lokal: kosongkan (root domain /)
# Server utility.uika-bogor.ac.id: /detector-text
BASE_PATH=

# Token untuk aksi yang mengubah dataset/model (belajar, umpan balik, hapus, latih ulang).
# Kosongkan = siapa pun yang membuka web boleh mengajari model. Isi untuk produksi.
LEARN_TOKEN=

# Model aktif (keluar dari mode heuristik) setelah minimal N contoh per kelas
MIN_SAMPLES_PER_CLASS=5
# Latih ulang penuh otomatis setiap N contoh baru (0 = nonaktif)
AUTO_RETRAIN_EVERY=50
# Contoh lama per kelas yang diputar ulang saat belajar incremental
REPLAY_PER_CLASS=16
# Impor massal dengan >= N contoh baru langsung memicu latih ulang penuh
BULK_RETRAIN_THRESHOLD=100
# false = hanya 500 karakter pertama teks pengecekan yang disimpan (privasi);
# umpan balik dari riwayat tidak bisa dipakai bila false
STORE_CHECK_TEXT=true

# ================= Modul Cek Kemiripan =================
# Penyedia pencarian web: searxng (gratis tanpa kuota, self-hosted) | brave | none
SEARCH_PROVIDER=searxng
BRAVE_API_KEY=
SERPAPI_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
SEARXNG_URL=http://searxng:8080
SEARXNG_SECRET=uika-searxng-secret-987654321
SEARCH_LANG=id
# Biaya API ≈ SEARCH_MAX_QUERIES kueri per dokumen yang diperiksa
SEARCH_MAX_QUERIES=10
WEB_MAX_FETCH=15
# Halaman hasil pencarian disimpan sebagai cache sekian hari, lalu dihapus otomatis
WEB_CACHE_DAYS=30

# Crawling otomatis setiap hari pada jam ini (zona waktu CRAWL_TZ)
CRAWL_TIME=01:00
CRAWL_TZ=Asia/Jakarta
# Hari untuk sumber berjadwal "mingguan": 0=Senin … 6=Minggu
CRAWL_WEEKLY_DAY=6
# Batas dokumen baru/berubah per sumber per malam (sisanya dilanjutkan malam berikutnya)
CRAWL_MAX_DOCS=500
# Jeda minimum antarpermintaan ke server yang sama (detik) — jaga kesopanan crawler
CRAWL_DELAY_SEC=1
# true bila repositori berada di jaringan internal kampus (IP privat)
CRAWL_ALLOW_PRIVATE=false
CRAWL_USER_AGENT=DetektorKemiripanBot/1.0 (+https://kampus-anda.ac.id/kontak)
